# =====================================================================
# AfeyFX - environment configuration
# Copy to .env (repo root) or server/.env and fill in. NEVER commit .env.
# Generate secrets with: ./scripts/generate-secrets.sh
# =====================================================================

NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the dashboard URL)
CLIENT_ORIGIN=http://localhost:5173

# --- Database (bind MongoDB to 127.0.0.1 and enable auth in production) ---
MONGODB_URI=mongodb://127.0.0.1:27017/afeyfx

# --- Auth / crypto (required in production) ---
# >= 32 random chars each
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# 64 hex chars (32 bytes) - encrypts exchange API credentials and 2FA secrets at rest
ENCRYPTION_KEY=
# Secure cookies (requires HTTPS). Keep true in production.
COOKIE_SECURE=true
# Public URL of the dashboard (used in email links and OAuth redirects), e.g. https://trading.example.com
APP_URL=
# Public API base if different from APP_URL (OAuth callback = <API_PUBLIC_URL>/api/auth/<provider>/callback)
API_PUBLIC_URL=

# --- Accounts ---
# Public sign-up for TRADER accounts (personal demo account). The first account ever becomes admin.
ALLOW_PUBLIC_SIGNUP=true
# Trading / admin actions require a verified email address
REQUIRE_EMAIL_VERIFICATION=true

# --- Email (verification links, email 2FA codes, security notices) ---
# Without SMTP in development, emails are written to the server log. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AfeyFX <no-reply@example.com>

# --- Social sign-in (optional) ---
# Google: OAuth client (Web). Authorized redirect URI: <API_PUBLIC_URL or APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: OAuth App. Authorization callback URL: <API_PUBLIC_URL or APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Claude AI (analysis only - AI can never place orders) ---
ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TOKENS=16000
AI_MIN_CONFIDENCE=0.65

# --- Exchanges ---
# Create keys with TRADING enabled and WITHDRAWALS DISABLED, IP-restricted to the server.
# Keys can alternatively be added (encrypted) from the Admin panel.
DEFAULT_EXCHANGE=binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Market data ---
MARKET_SYMBOLS=BTC/USDT,ETH/USDT
# Supported: 1m,3m,5m,15m,30m,1h,4h,1d
MARKET_TIMEFRAMES=1m,5m,15m,1h
MARKET_DATA_ENABLED=true
# exchange | simulated  (simulated = synthetic prices for local development ONLY; refused in production, LIVE impossible)
MARKET_DATA_SOURCE=exchange
# Extra crypto pairs offered to traders (empty = built-in list: BTC, ETH, SOL, BNB, XRP, ADA, DOGE, LTC,
# AVAX, DOT, LINK, TRX, BCH, ATOM, NEAR, UNI, XLM, TON vs USDT). The strategy engine trades only MARKET_SYMBOLS.
TRADER_CRYPTO_SYMBOLS=

# --- Forex & metals (EUR/USD, GBP/USD, USD/JPY, 40+ pairs, gold, silver) ---
# Prices come from OANDA v20 (read-only pricing; free practice account works). Without credentials the
# forex/metals markets are hidden. Can also be set in the admin console (Integrations).
FOREX_ENABLED=true
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
MARKET_DATA_STALE_MS=30000
JOBS_ENABLED=true

# --- Trading mode ---
# The app ALWAYS starts in PAPER. LIVE needs LIVE_TRADING_ENABLED=true here AND an admin
# activation (preflight + password + 2FA + confirmation phrase) in the dashboard.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# --- Risk defaults (editable within hard bounds from the admin dashboard) ---
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_WEEKLY_LOSS=0.05
MAX_OPEN_POSITIONS=5
MAX_PORTFOLIO_EXPOSURE=0.20
MAX_LEVERAGE=1
MAX_SPREAD_PCT=0.002
MAX_SLIPPAGE_PCT=0.003
MAX_CLOCK_DRIFT_MS=1000

# --- Paper trading simulation ---
PAPER_STARTING_BALANCE=10000
PAPER_FEE_RATE=0.001
PAPER_SLIPPAGE_PCT=0.0005
PAPER_LATENCY_MS=150
PAPER_REJECT_RATE=0.01

# --- News for AI context (optional) ---
# Comma-separated HTTPS RSS/Atom feeds you trust. Headlines are treated as untrusted data.
NEWS_ENABLED=false
NEWS_RSS_URLS=
NEWS_MAX_AGE_HOURS=24

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info

# --- Admin console ---
# Every integration key above (SMTP, Google, GitHub, Anthropic, Telegram, OANDA, news, URLs, sign-up) can
# also be set from Admin console -> Integrations; values saved there override this file and are encrypted.
# M-Pesa (Daraja) credentials, limits and fees live in Admin console -> Payments (database, encrypted).
# Broker routing (Deriv / OANDA) lives in Admin console -> Brokers and additionally requires
# LIVE_TRADING_ENABLED=true here: external broker orders are real orders.

# --- User broker connections (traders connect their OWN accounts; see docs/BROKERS.md) ---
# Deriv, current API (developers.deriv.com). Register an app; redirect URL:
#   <API_PUBLIC_URL or APP_URL>/api/brokers/deriv/callback
# Request the "trade" scope only. "payment" is always refused by the server.
DERIV_CLIENT_ID=
# App ID (needed for Personal Access Tokens and REST calls made with them)
DERIV_APP_ID=
DERIV_AUTH_URL=https://auth.deriv.com/oauth2/auth
DERIV_TOKEN_URL=https://auth.deriv.com/oauth2/token
DERIV_API_BASE=https://api.derivws.com/trading/v1/
DERIV_OAUTH_SCOPES=trade
# Allow users to paste a Personal Access Token instead of OAuth (needs DERIV_APP_ID)
DERIV_ALLOW_PAT=true
# MetaTrader 5 via the AfeyFX Bridge EA (bridge/mt5/AfeyFXBridge.mq5). Terminals call /api/bridge/mt5/*.
MT5_BRIDGE_ENABLED=true
MT5_BRIDGE_MAX_SKEW_MS=60000
# Let users enable real-money trading on their own REAL broker accounts. Even when true, every live order
# also needs LIVE_TRADING_ENABLED=true, the user's password + 2FA + typed confirmation, and a passing
# connection test that proves the account is real. Keep false until demo trading has been verified.
BROKER_USER_LIVE_ALLOWED=false
